# ==========================================
# CONFIGURACIÓN DJANGO (BACKEND)
# ==========================================
# NOTA: En desarrollo usar True. En Render/Producción debe ser obligatoriamente False.
# (También se acepta el alias DEBUG)
DJANGO_DEBUG=True
# OBLIGATORIO: Generar una llave aleatoria para el entorno local (mínimo 32 caracteres).
# (También se acepta el alias SECRET_KEY). Dejar vacío en la plantilla por seguridad:
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_COOKIE_SECURE=False
REFRESH_TOKEN_COOKIE_SAMESITE=Strict
MAX_FAILED_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=5
SEED_DEMO_DATA=True
SEED_DEMO_MASTER_DATA=True
DJANGO_SUPERUSER_RUT=11111111-1
DJANGO_SUPERUSER_EMAIL=admin@minera.local
DJANGO_SUPERUSER_PASSWORD=
DEMO_CARGADOR_RUT=22222222-2
DEMO_CARGADOR_EMAIL=cargador@minera.local
DEMO_CARGADOR_PASSWORD=
DEMO_CONSULTOR_RUT=33333333-3
DEMO_CONSULTOR_EMAIL=consultor@minera.local
DEMO_CONSULTOR_PASSWORD=

# ==========================================
# CONFIGURACIÓN POSTGRESQL (BASE DE DATOS)
# ==========================================
DB_NAME=sgp_minero_db
DB_USER=usuario_local
# OBLIGATORIO: Definir contraseña local de PostgreSQL antes de levantar Docker:
DB_PASSWORD=
# NOTA DE RED: En un entorno Dockerizado, el host debe ser el nombre del servicio
# en la red de contenedores (ej. 'db' o el nombre específico de la red), no 'localhost'.
DB_HOST=db
DB_PORT=5432

# ==========================================
# CRIPTOGRAFÍA AES / FERNET (LEY 19.628 - PII)
# ==========================================
# OBLIGATORIO: Llave simétrica de 32 bytes codificada en URL-safe base64 para 'cryptography'.
# (También se acepta el alias AES_ENCRYPTION_KEY).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_SECRET_KEY=

# ==========================================
# CONFIGURACIÓN REACT / VITE (FRONTEND)
# ==========================================
# Las variables expuestas al frontend en Vite deben iniciar con VITE_
VITE_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173